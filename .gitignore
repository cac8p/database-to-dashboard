# Python virtual environment and caches
.venv/
__pycache__/
*.pyc

# Generated raw data: anyone can recreate it by running the generator,
# so it stays out of GitHub (keeps the repo small)
data/raw/**/*.csv
!data/raw/**/.gitkeep

# Local database files
*.duckdb
*.duckdb.wal

# dbt build output
dbt/**/target/
dbt/**/dbt_packages/
dbt/**/logs/

dbt/.user.yml

# Secrets: never commit passwords or API keys.
# (dbt/profiles.yml IS committed: it holds no secrets, only env_var() lookups.)
.env

# Editor / OS clutter
.vscode/
.DS_Store
Thumbs.db
